--- a/app/src/main/assets/index.html
+++ b/app/src/main/assets/index.html
@@ -4081,5 +4081,177 @@
 </script>
 <!-- V85: Jane-style knowledge synthesis and a fully scrollable response card. No Archive, startup, model, portrait, voice, tools, or import systems changed. -->
 
+
+
+<script id="v87-real-ai-rag-responder">
+(function(){
+  const priorChat=window.chat;
+  const CHAT_URL=typeof CHAT_ENDPOINT==="string"?CHAT_ENDPOINT:"https://jane-elevenlabs-backend.onrender.com/api/chat";
+  const KNOWLEDGE_URL=CHAT_URL.replace(/\/api\/chat(?:\?.*)?$/,"/api/knowledge-chat");
+  const pending=new Map();
+  let requestCounter=0;
+
+  function decodeUtf8B64(value){
+    try{
+      const bytes=Uint8Array.from(atob(String(value||"")),c=>c.charCodeAt(0));
+      return new TextDecoder("utf-8").decode(bytes);
+    }catch(error){return "";}
+  }
+  function requestedCount(query){
+    const words={one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9,ten:10};
+    const text=String(query||"").toLowerCase();
+    const match=text.match(/\b(\d{1,2}|one|two|three|four|five|six|seven|eight|nine|ten)\b(?=[\s\S]{0,60}\b(?:facts?|reasons?|points?|ideas?|examples?|things?|basics?|rules?|steps?)\b)/i);
+    if(!match)return 0;
+    const value=/^\d+$/.test(match[1])?Number(match[1]):words[match[1]]||0;
+    return Math.max(1,Math.min(10,value));
+  }
+  function topicFromQuery(query){
+    const raw=String(query||"").trim();
+    const about=raw.match(/\b(?:about|on|regarding|concerning)\s+(.+?)[?.!]*$/i);
+    if(about?.[1])return about[1].replace(/\b(?:facts?|reasons?|points?|ideas?|examples?|things?)\b/gi," ").replace(/\s+/g," ").trim();
+    return raw
+      .replace(/\b(?:please|can you|could you|would you|tell me|give me|show me|list|name|explain|summarize|what is|what are)\b/gi," ")
+      .replace(/\b(?:\d{1,2}|one|two|three|four|five|six|seven|eight|nine|ten)\b/gi," ")
+      .replace(/\b(?:quick|random|important|key|basic|facts?|reasons?|points?|ideas?|examples?|things?|rules?|steps?)\b/gi," ")
+      .replace(/[?.!]+/g," ").replace(/\s+/g," ").trim()||raw;
+  }
+  function queryVariants(question){
+    const topic=topicFromQuery(question);
+    const lower=topic.toLowerCase();
+    const domain={
+      physics:"physics force motion energy matter waves electricity magnetism thermodynamics quantum",
+      biology:"biology life cells organisms genetics evolution ecology anatomy physiology",
+      chemistry:"chemistry atoms molecules elements compounds reactions bonding acids bases",
+      astronomy:"astronomy stars planets galaxies gravity universe cosmology",
+      medicine:"medicine health disease diagnosis treatment anatomy physiology pathology",
+      history:"history events causes consequences people chronology civilization",
+      mathematics:"mathematics numbers algebra geometry calculus probability statistics"
+    };
+    const expanded=Object.keys(domain).find(key=>lower.includes(key));
+    return [...new Set([String(question||"").trim(),topic,expanded?domain[expanded]:""].filter(Boolean))].slice(0,3);
+  }
+  function nativeSearch(query,limit){
+    return new Promise(resolve=>{
+      if(!window.AndroidJane||typeof window.AndroidJane.searchKnowledgeArchives!=="function"){resolve([]);return;}
+      const requestId="v87_"+Date.now()+"_"+(++requestCounter);
+      const timer=setTimeout(()=>{pending.delete(requestId);resolve([]);},18000);
+      pending.set(requestId,{resolve,timer});
+      try{window.AndroidJane.searchKnowledgeArchives(requestId,String(query||""),Math.max(12,Number(limit)||24));}
+      catch(error){clearTimeout(timer);pending.delete(requestId);resolve([]);}
+    });
+  }
+  const priorNativeResult=window.JaneNativeKnowledgeSearchResult;
+  window.JaneNativeKnowledgeSearchResult=function(requestId,base64){
+    const waiting=pending.get(requestId);
+    if(!waiting){if(typeof priorNativeResult==="function")return priorNativeResult.apply(this,arguments);return;}
+    clearTimeout(waiting.timer);pending.delete(requestId);
+    try{
+      const payload=JSON.parse(decodeUtf8B64(base64)||"{}");
+      waiting.resolve(Array.isArray(payload.results)?payload.results:[]);
+    }catch(error){waiting.resolve([]);}
+  };
+  function cleanExcerpt(value){
+    let text=String(value||"")
+      .replace(/\r/g,"\n")
+      .replace(/([A-Za-z]{3,})-\s*\n\s*([a-z]{2,})/g,"$1$2")
+      .replace(/[ \t]+/g," ")
+      .replace(/\n{3,}/g,"\n\n")
+      .replace(/\bThis page intentionally left blank\b/gi,"")
+      .replace(/\b(?:ISBN(?:-1[03])?|copyright)\b[^\n]*/gi,"")
+      .trim();
+    const lines=text.split(/\n+/).map(line=>line.trim()).filter(line=>{
+      if(line.length<24)return false;
+      if(/^(?:contents?|chapter\s+\d+|table of contents|index|preface)\b/i.test(line))return false;
+      const letters=(line.match(/[A-Za-z]/g)||[]).length;
+      return letters>=18;
+    });
+    return lines.join(" ").replace(/\s+/g," ").trim();
+  }
+  async function gatherExcerpts(question){
+    const batches=await Promise.all(queryVariants(question).map(query=>nativeSearch(query,28)));
+    const rows=[],seen=new Set();
+    for(const batch of batches){
+      for(const row of batch||[]){
+        const text=cleanExcerpt(row.text||"");
+        if(!text)continue;
+        const key=(String(row.archiveId||row.source||"")+"|"+text.slice(0,240)).toLowerCase();
+        if(seen.has(key))continue;
+        seen.add(key);
+        rows.push({source:String(row.source||"Knowledge source"),text,score:Number(row.score||0)});
+      }
+    }
+    rows.sort((a,b)=>b.score-a.score);
+    const excerpts=[];
+    let used=0;
+    for(const row of rows){
+      const clipped=row.text.slice(0,1800);
+      if(used+clipped.length>11000)continue;
+      excerpts.push({source:row.source,text:clipped});
+      used+=clipped.length;
+      if(excerpts.length>=10)break;
+    }
+    return excerpts;
+  }
+  function validAiReply(reply,count){
+    const text=String(reply||"").trim();
+    if(text.length<24)return false;
+    if(/could not form a reliable answer|matching Archive material|extracted text is too damaged/i.test(text))return false;
+    if(/\b(\w+)\s+\1\b/i.test(text))return false;
+    if((text.match(/[A-Za-z]/g)||[]).length<20)return false;
+    if(count){
+      const numbered=(text.match(/(?:^|\n)\s*\d+[.)]\s+/g)||[]).length;
+      if(numbered&&numbered<count)return false;
+    }
+    return true;
+  }
+  async function postJson(url,body,timeoutMs){
+    const controller=new AbortController();
+    const timer=setTimeout(()=>controller.abort(),timeoutMs||45000);
+    try{
+      const response=await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body),signal:controller.signal});
+      const raw=await response.text();
+      let data;try{data=JSON.parse(raw);}catch{data={error:raw};}
+      if(!response.ok)throw new Error(data.error||("HTTP "+response.status));
+      return data;
+    }finally{clearTimeout(timer);}
+  }
+  async function askReasoningService(question,excerpts){
+    const count=requestedCount(question);
+    const history=(typeof state!=="undefined"&&Array.isArray(state.history)?state.history:[]).slice(-4);
+    const ownerVerified=Boolean(typeof state!=="undefined"&&state.ownerVerified);
+    try{
+      const data=await postJson(KNOWLEDGE_URL,{question,excerpts,history,ownerVerified,requestedCount:count},50000);
+      if(validAiReply(data.reply,count))return data.reply.trim();
+      throw new Error("Reasoning service returned malformed text.");
+    }catch(primaryError){
+      const context=excerpts.map((item,index)=>`SOURCE ${index+1}: ${item.source}\n${item.text}`).join("\n\n---\n\n");
+      const prompt=`You are Jane, an actual reasoning assistant. Answer the user's question by understanding and synthesizing the supplied knowledge. Do not copy, splice, or concatenate raw PDF sentences. Correct obvious OCR damage silently. Use natural language. If the user requests a number of facts or reasons, provide exactly that many distinct numbered items. Do not mention archives, excerpts, files, or sources unless asked.\n\nUSER QUESTION:\n${question}\n\nKNOWLEDGE:\n${context}`;
+      const data=await postJson(CHAT_URL,{message:prompt,history:[]},50000);
+      if(validAiReply(data.reply,count))return data.reply.trim();
+      throw primaryError;
+    }
+  }
+  async function v87Chat(message){
+    const question=String(message||"").trim();
+    if(!question)return "";
+    const excerpts=await gatherExcerpts(question);
+    if(!excerpts.length){
+      return "I don’t have enough relevant knowledge stored for that question yet. Add material that covers it, then ask me again in your own words.";
+    }
+    // Android WebView can report navigator.onLine=false even while HTTPS works.
+    // Always attempt the reasoning service and judge the real request result instead.
+    try{return await askReasoningService(question,excerpts);}
+    catch(error){
+      console.error("[Jane V87 reasoning]",error);
+      return "I found the relevant material, but the AI reasoning service did not complete the answer. I’m refusing to replace it with scrambled PDF fragments. Check the connection and try again.";
+    }
+  }
+  window.chat=v87Chat;
+  try{chat=v87Chat;}catch(error){}
+  window.JANE_V87_REAL_AI_RAG={semanticQueryExpansion:true,multiQueryRetrieval:true,aiOnlySynthesis:true,noFragmentStitching:true,exactCountAnswers:true,transparentFailure:true};
+})();
+</script>
+<!-- V87: retrieval supplies knowledge; the AI reasons and writes the response. Raw PDF sentence stitching is never presented as an AI answer. -->
+
 </body>
 </html>
