<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:background="@drawable/jane_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:foregroundGravity="center">

        <TextView
            android:id="@+id/widgetLogo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:background="@drawable/jane_widget_icon_bg"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:text="J"
            android:textColor="#F2FCFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/jane_widget_status_dot" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widgetTalk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:text="JANE // LINK ACTIVE"
            android:textColor="#EAFBFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="OPEN COMMAND DECK"
            android:textColor="#8FC6D2"
            android:textSize="9sp" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/jane_widget_signal_bar" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetMic"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/jane_widget_action_bg"
        android:drawableTop="@drawable/jane_widget_mic"
        android:drawablePadding="1dp"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="4dp"
        android:text="VOICE"
        android:textColor="#CFF8FF"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetImage"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/jane_widget_action_bg"
        android:drawableTop="@drawable/jane_widget_vision"
        android:drawablePadding="1dp"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="4dp"
        android:text="VISION"
        android:textColor="#FFDDA0"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>
