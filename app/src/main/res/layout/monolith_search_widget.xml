<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monolithWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/monolith_widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MONOLITH AI"
            android:textColor="#E6FAFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCAL CORE // READY"
            android:textColor="#7DFFD2"
            android:textSize="7sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:id="@+id/monolithWidgetSearch"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/monolith_widget_action_bg"
        android:text="QUERY LOCAL ARCHIVES FIRST"
        android:textColor="#AEEAF5"
        android:textSize="10sp"
        android:fontFamily="monospace" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/monolithWidgetVoice"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/monolith_widget_action_bg"
            android:text="VOICE"
            android:textColor="#48E6FF"
            android:textSize="8sp"
            android:fontFamily="monospace" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/monolithWidgetVision"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/monolith_widget_action_bg"
            android:text="VISION"
            android:textColor="#4D7DFF"
            android:textSize="8sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
