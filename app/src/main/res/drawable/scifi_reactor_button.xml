<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0F172A" />
            <stroke android:width="3dp" android:color="#334155" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#6600E5FF" />
            <solid android:color="#02060D" />
        </shape>
    </item>
    <item android:top="9dp" android:bottom="9dp" android:left="9dp" android:right="9dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="24dp" android:startColor="#E0F7FA" android:centerColor="#00B8D4" android:endColor="#004D40" />
        </shape>
    </item>
    <item android:gravity="top|right" android:top="5dp" android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF6D00" />
            <size android:width="10dp" android:height="3dp" />
        </shape>
    </item>
</layer-list>
