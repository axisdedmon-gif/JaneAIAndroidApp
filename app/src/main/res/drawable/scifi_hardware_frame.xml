<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="24dp" android:topRightRadius="4dp" android:bottomRightRadius="24dp" android:bottomLeftRadius="4dp" />
            <solid android:color="#050914" />
            <stroke android:width="2dp" android:color="#1A2B4C" />
            <padding android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="21dp" android:topRightRadius="3dp" android:bottomRightRadius="21dp" android:bottomLeftRadius="3dp" />
            <stroke android:width="1dp" android:color="#9900E5FF" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:topRightRadius="2dp" android:bottomRightRadius="16dp" android:bottomLeftRadius="2dp" />
            <solid android:color="#B300050A" />
            <stroke android:width="1dp" android:color="#331B5A6B" />
        </shape>
    </item>
    <item android:gravity="top|right" android:top="10dp" android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF6D00" />
            <size android:width="22dp" android:height="4dp" />
        </shape>
    </item>
    <item android:gravity="top|right" android:top="10dp" android:right="44dp">
        <shape android:shape="rectangle">
            <solid android:color="#9900E5FF" />
            <size android:width="8dp" android:height="4dp" />
        </shape>
    </item>
    <item android:gravity="bottom|left" android:bottom="10dp" android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#6600E5FF" />
            <size android:width="34dp" android:height="2dp" />
        </shape>
    </item>
</layer-list>
