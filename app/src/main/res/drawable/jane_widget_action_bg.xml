<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B640DDF7"
                        android:endColor="#DD07151D" />
                    <stroke android:width="2dp" android:color="#F6A7F4FF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <corners android:radius="13dp" />
                    <solid android:color="#C8010509" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="13dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B42A6575"
                        android:centerColor="#ED10242D"
                        android:endColor="#F4040A0F" />
                    <stroke android:width="1dp" android:color="#C956DDF6" />
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="8dp">
                <shape>
                    <corners android:radius="9dp" />
                    <solid android:color="#301CCCEB" />
                    <stroke android:width="1dp" android:color="#4AE5FBFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
