<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#B0000307" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape>
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#F3152A35"
                android:centerColor="#F407111A"
                android:endColor="#FA02070D" />
            <stroke
                android:width="2dp"
                android:color="#9D3BCDE9" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="6dp">
        <shape>
            <corners android:radius="15dp" />
            <gradient
                android:angle="0"
                android:startColor="#8A102D3A"
                android:centerColor="#32101F29"
                android:endColor="#721B1714" />
            <stroke
                android:width="1dp"
                android:color="#774F7C88" />
        </shape>
    </item>
</layer-list>
